# Copy to .env and adjust if needed (optional).
# .env is gitignored — never commit real secrets.
# The server loads this file automatically on startup.
# Existing shell environment variables always win.

# HTTP port for the UI server
PORT=3100

# Server status bot poll interval in milliseconds (default: 5 minutes)
# Examples: 300000 = 5 min, 60000 = 1 min, 30000 = 30 sec
HEALTH_POLL_MS=300000
