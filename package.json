{
  "name": "simplifyqa-testcase-mapper-compare",
  "version": "1.0.0",
  "description": "ICEA LION QA tool: map client testcases to SimplifyQA Excel and compare Gen UG vs Life UG workbooks",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sanjay01Rep/simplifyqa-testcase-mapper-compare.git"
  },
  "scripts": {
    "prestart": "node scripts/free-port.js",
    "start": "node server.js",
    "start:window": "cmd /c start \"ICEA LION UI\" cmd /k \"node scripts/free-port.js && node server.js\"",
    "ui": "node scripts/free-port.js && node server.js",
    "map": "node map_to_simplifyqa.js",
    "map:all": "node map_to_simplifyqa.js --all",
    "test": "node test/e2e.js"
  },
  "keywords": [
    "simplifyqa",
    "testcase",
    "mapper",
    "compare",
    "icea-lion",
    "qa"
  ],
  "author": "Simplify3x",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mammoth": "^1.9.0",
    "multer": "^2.0.1",
    "xlsx": "^0.18.5"
  }
}
